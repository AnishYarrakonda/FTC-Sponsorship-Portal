{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code detection. Next.js App Router files are ENTRY POINTS, not unused exports:
  // a page.tsx default export is called by the framework and never imported, so a naive
  // run reports every route in the app as dead. The entry list below encodes that.
  //
  // Run: npm run knip   (also part of npm run verify:all)
  //
  // Before deleting anything knip reports, confirm with a grep for call sites. Two classes
  // of export here are legitimately "unused" to static analysis and must NOT be removed:
  //   - server actions invoked from client components across the 'use server' boundary
  //   - helpers referenced only by SQL migrations or by RPC name

  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/template.tsx",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/global-error.tsx",
    "app/**/route.ts",
    "app/**/default.tsx",
    "app/**/opengraph-image.tsx",
    "app/**/icon.tsx",
    "app/**/sitemap.ts",
    "app/**/robots.ts",
    "app/actions/**/*.ts",
    "middleware.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "next.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "emails/**/*.tsx"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "emails/**/*.tsx"
  ],

  // Generated file; regenerated by `supabase gen types`, so churn here is not dead code.
  "ignore": ["lib/supabase/types.ts"],

  // components/ui is the shadcn design-system surface. Its files ARE checked (an entirely
  // unimported component still gets reported), but a component deliberately re-exporting
  // its full Radix API is not dead code, and flagging all of it drowns real findings.
  // A check that always reports noise is a check nobody reads.
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [],

  // knip does not parse CSS, so it cannot see these. Both are pulled in by
  // `@import` in app/globals.css — removing either silently breaks styling.
  "ignoreDependencies": [
    "tailwindcss",
    "@tailwindcss/postcss",
    "eslint-config-next",
    "shadcn",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["psql", "vercel", "supabase", "mktemp"],

  // Severity split, so `npm run verify:all` fails on what is actually rot and merely
  // reports what is judgement. An unused FILE or DEPENDENCY is dead weight and should
  // break the build. An unused EXPORT usually is not: components/ui is vendored shadcn
  // code that deliberately re-exports its full Radix surface, and failing on that would
  // make the whole check noise people learn to ignore.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "enumMembers": "warn",
    "classMembers": "warn"
  }
}
