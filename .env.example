# ─── Supabase ────────────────────────────────────────────────────────────────
# Project REST URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Anon key. Use the LEGACY JWT (starts with "eyJ", Settings → API → JWT keys).
# The new sb_publishable_/sb_secret_ format is NOT reliably accepted by the API
# (sb_secret_ returns 401 on PostgREST + Auth Admin), so prefer the legacy JWTs.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key — legacy JWT (starts with "eyJ").
# SERVER-ONLY. Never expose to the browser. Bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Clerk (auth) ────────────────────────────────────────────────────────────
# Auth provider. Sessions, email verification, password reset, password policy.
# Dashboard step (not env): register Clerk as a Supabase third-party auth provider
# so RLS trusts the Clerk JWT (auth.jwt()->>'sub'). Set Clerk password policy 12+/upper/lower/number.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# SERVER-ONLY.
CLERK_SECRET_KEY=your_clerk_secret_key
# Svix signing secret for the Clerk webhook (app/api/webhooks/clerk). REQUIRED in production.
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret
# Optional: point Clerk's hosted flows at the app's own pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
# Must be a verified sending domain. In production this MUST start with "noreply@".
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Svix signing secret for the Resend webhook. REQUIRED in production.
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the deployment, e.g. https://yourdomain.com (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: comma-separated admin emails for system alerts.
# If unset, alerts fall back to a profiles.role='admin' lookup.
ADMIN_NOTIFICATION_EMAILS=

# ─── Sentry (optional error monitoring) ──────────────────────────────────────
# LEAVE BLANK unless you have a real DSN. lib/env.ts tolerates a malformed value on
# purpose, because the literal placeholder that used to sit here got copied into Vercel
# more than once — a project name is not a DSN, and the app should not 500 over telemetry.
SENTRY_DSN=
# Public DSN for client-side error capture (safe to expose; can equal SENTRY_DSN)
NEXT_PUBLIC_# LEAVE BLANK unless you have a real DSN. lib/env.ts tolerates a malformed value on
# purpose, because the literal placeholder that used to sit here got copied into Vercel
# more than once — a project name is not a DSN, and the app should not 500 over telemetry.
SENTRY_DSN=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret for the daily Vercel cron (/api/cron/expire-submissions). REQUIRED.
# Vercel automatically sends this as the Bearer token for scheduled cron invocations.
CRON_SECRET=your_cron_secret

# ─── FIRST API (optional) ────────────────────────────────────────────────────
# Official FIRST team-roster lookup, used to verify that a coach's team number is real.
# DELIBERATELY OPTIONAL: making these required would take the whole site down for anyone
# without FIRST credentials. When unset, verification silently falls back to FTCScout —
# which works, but means official verification is off and nothing tells you so.
FIRST_API_USERNAME=
FIRST_API_TOKEN=

# ─── Direct Postgres connection (local tooling only) ─────────────────────────
# NOT read by the app — used by `psql -f` for migrations and by scripts/*.mjs.
# Supabase dashboard → Settings → Database → Connection string (session pooler).
# Remember to percent-encode special characters in the password.
DATABASE_URL=
